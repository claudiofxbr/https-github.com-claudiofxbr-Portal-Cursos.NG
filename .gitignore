# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
dev-dist-ssr
*.local
.pnpm-store
.pnpm

# pods-manager atomic build operations (rename/restore leftovers).
# AppManager creates these during build (set-aside previous output before
# running pnpm build, restore on failure). Success path cleans them up;
# failure paths may leave orphans. Always ignore them in version control +
# in the sandbox memGit hydration (see ProjectSandbox.hydrate).
*.bak-*
*.legacy-bak-*
*.failed-*
*.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Evaluation screenshots
screenshot.png
.eslintcache
.oxlintcache

# Environment variables and secrets — NEVER commit real credentials.
# Only .env.example (sem segredos reais) pode ser versionado.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# PocketBase local data (dados pessoais — LGPD) e binários do PocketBase
pocketbase/pb_data/
pb_data/
pocketbase/pocketbase
pocketbase/pocketbase.exe
pocketbase/*.zip

# Dependências de auditoria
audit-out/

# Linux kernel core dumps (e.g. when oxfmt or pnpm crash)
core.[0-9]*
